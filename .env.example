# ==========================================================
#  APLIKASI ABSENSI FINGERPRINT - KONFIGURASI
#  Salin file ini menjadi .env lalu sesuaikan dengan server Anda
# ==========================================================

# --- Server aplikasi ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Aset frontend statis
PUBLIC_DIR=public

# --- Database MySQL / MariaDB (XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=absensi
DB_CONNECTION_LIMIT=10

# --- Keamanan / login ---
# WAJIB diganti sebelum dipakai di server produksi (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-panjang-sekarang
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- Zona waktu (penting untuk perhitungan shift & keterlambatan) ---
TZ=Asia/Jakarta

# --- Perilaku absensi ---
# Batas akhir scan finger considered "absen hari ini"
ATTENDANCE_CUTOFF_TIME=23:59:59
# Toleransi keterlambatan default (menit), bisa dioverride per shift
DEFAULT_LATE_TOLERANCE=10
# Batas maksimal jam kerja sebelum dihitung lembur (menit)
MAX_DAILY_WORK_MINUTES=600

# --- Sinkronisasi mesin fingerprint ---
# MATI default: auto-sync bikin UI macet (berebut pool DB). Nyalakan (true)
# hanya bila mesin sudah stabil di jaringan lokal.
SYNC_ENABLED=false
# Menit antar polling otomatis (bila SYNC_ENABLED=true)
SYNC_INTERVAL_MINUTES=5
# Batas waktu (ms) saat menunggu mesin merespons
DEVICE_TIMEOUT_MS=20000
# Setelah sinkron dari mesin, hapus log di mesin? (true = mesin dibersihkan)
DEVICE_CLEAR_LOG_AFTER_SYNC=false
# Server HTTP untuk mesin ber-mode PUSH (ADMS / icLock)
PUSH_PORT=3001
# Token yang wajib ada pada mesin saat melakukan PUSH (kosong = tanpa token)
PUSH_AUTH_TOKEN=

# --- Notifikasi Email (SMTP) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Aplikasi Absensi <absensi@contoh.com>"

# --- Notifikasi WhatsApp ---
# provider: gateway (Fonnte/Wablas/custom) atau self (nomor sendiri, scan QR)
# Contoh payload gateway Fonnte: {"target":"62812xxx","message":"..."}
# Contoh payload gateway Wablas: {"phone":"62812xxx","message":"..."}
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=gateway
WHATSAPP_URL=
WHATSAPP_TOKEN=
# Nomor TUJUAN (penerima), boleh banyak pisahkan koma untuk broadcast:
# contoh: 62812xxxxxxx, 62813xxxxxxx
WHATSAPP_TARGET=
# Nama field JSON gateway. Fonnte: target + message. Wablas: phone + message.
WHATSAPP_FIELD_TARGET=target
WHATSAPP_FIELD_MESSAGE=message
# Nomor sendiri: sesi login tersimpan di folder ini (jangan di-commit)
WHATSAPP_SELF_SESSION=storage/whatsapp-session
# Nomor sendiri: sambungkan otomatis saat server nyala
WHATSAPP_SELF_AUTOSTART=true
# Anti-banned nomor sendiri: jeda acak antar pesan + batas laju
WHATSAPP_SELF_MIN_DELAY_MS=4000
WHATSAPP_SELF_MAX_DELAY_MS=9000
WHATSAPP_SELF_PER_MINUTE=12
WHATSAPP_SELF_DAILY_LIMIT=300

# --- Halaman login / pengaturan umum ---
# Backfill rekap untuk N hari terakhir saat generate
BACKFILL_DAYS=30

# --- Hari libur nasional ---
# Diatur dari UI: menu "Hari Libur" (daftar & sinkronisasi) dan
# "Pengaturan > Hari Libur" (sinkronisasi otomatis).
# Data libur disimpan di tabel holidays sehingga rekap tetap bisa dihitung
# walau internet mati.
